# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JELLYFIN_URL=http://host.docker.internal:8096
PUBLIC_URL=http://localhost:8000
COOKIE_SECURE=false
# Local development runs Redis on loopback; Compose overrides this.
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL=604800
# Exact endpoints supplied by your iptv-gtw deployment; reachable from Jellyfin.
IPTV_M3U_URL=
IPTV_XMLTV_URL=
# Traefik override:
JISHFLIX_DOMAIN=cinema.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=letsencrypt
