# Optional: a random key is generated on first start and kept in the data
# volume (0600, jishflix user only) if you leave this unset.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JELLYFIN_URL=http://host.docker.internal:8096
PUBLIC_URL=http://localhost:8000
COOKIE_SECURE=false
# Local development runs Redis on loopback; Compose overrides this.
REDIS_URL=redis://127.0.0.1:6379/0
SESSION_TTL=604800
# Seerr, Whisparr, and the iptv-gtw connection are configured from the app itself
# (Settings > Configure integrations, admin only) and stored encrypted on the
# data volume, not here.
# Traefik override:
JISHFLIX_DOMAIN=cinema.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=letsencrypt
